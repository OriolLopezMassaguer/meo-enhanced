{
  "targetRoots": [
    "src/foundation",
    "src/domain",
    "src/application",
    "src/protocol",
    "src/host",
    "webview/src/application",
    "webview/src/adapters",
    "webview/src/bootstrap",
    "webview/src/editor"
  ],
  "bootstrapOnlyModules": [
    {
      "module": "webview/src/adapters/mermaidDiagramPresentationRuntime.ts",
      "allowedImporters": ["webview/src/index.ts"]
    },
    {
      "module": "webview/src/editor/mermaidDiagramPresentationAdapter.ts",
      "allowedImporters": ["webview/src/index.ts"]
    },
    {
      "module": "webview/src/editor/mermaidDiagramRenderPool.ts",
      "allowedImporters": ["webview/src/index.ts"]
    }
  ],
  "bootstrapLifecycleContracts": [
    {
      "file": "webview/src/index.ts",
      "constructors": [
        {
          "module": "webview/src/editor/mermaidDiagramRenderPool.ts",
          "export": "createMermaidDiagramRenderPool"
        },
        {
          "module": "webview/src/editor/mermaidDiagramPresentation.ts",
          "export": "createMermaidDiagramPresentationFactory"
        }
      ],
      "disposeOrder": [
        "createMermaidDiagramPresentationFactory",
        "createMermaidDiagramRenderPool"
      ]
    }
  ],
  "resourceOwnerFreeModules": ["webview/src/helpers/mermaidDiagram.ts"],
  "sharedModuleContracts": [
    {
      "module": "src/shared/latexMathScanner.ts",
      "exactImporters": ["webview/src/helpers/math.ts", "src/export/math.ts", "src/shared/mathFence.ts"],
      "delegates": [
        {
          "file": "webview/src/helpers/math.ts",
          "function": "parseLatexMathAt",
          "requiredCall": "scanLatexMathAt",
          "allowNullReturn": true
        },
        {
          "file": "webview/src/helpers/math.ts",
          "function": "collectLatexMathRanges",
          "requiredCall": "scanLatexMath",
          "allowedMethodCalls": ["map"]
        },
        {
          "file": "src/export/math.ts",
          "function": "collectLatexMathRanges",
          "requiredCall": "scanLatexMath"
        },
        {
          "file": "src/export/math.ts",
          "function": "parseLatexMathAt",
          "requiredCall": "scanLatexMathAt",
          "allowNullReturn": true
        }
      ]
    },
    {
      "module": "src/shared/punctuationInlineStyles.ts",
      "exactImporters": [
          "webview/src/helpers/punctuationSyntax.ts",
        "webview/src/helpers/highlightSyntax.ts",
        "src/shared/markdownPunctuation.ts",
        "src/shared/markdownHighlight.ts"
      ],
      "delegates": []
    }
  ],
  "knownLegacyTestFailures": []
}
